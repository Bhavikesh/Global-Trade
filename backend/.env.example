# ==============================================================================
# GlobalTrade.ai Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables for your local setup.
# Never commit real secrets to source control.
# ==============================================================================

# Application
PROJECT_NAME="GlobalTrade.ai API"
API_V1_PREFIX="/api"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL with psycopg v3 synchronous driver)
# Example: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+psycopg://bhavikesh@localhost:5432/globaltrade_dev"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS='["http://localhost:3000"]'

# Phase 1: Identity & Authentication (Auth0 placeholders - unused during Phase 0)
AUTH0_DOMAIN=""
AUTH0_AUDIENCE=""
